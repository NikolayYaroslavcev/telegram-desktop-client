{
  "name": "telegram-desktop-client",
  "version": "0.0.0",
  "private": true,
  "description": "Electron/TypeScript/React Telegram desktop client. Includes a standalone TDLib binding spike (task 01.x) kept as a technical reference.",
  "scripts": {
    "dev": "npm run dev:main && concurrently -k -s first \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:main": "npm run build:main && npm run build:preload",
    "dev:renderer": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron out/main/index.js",
    "build": "npm run typecheck:renderer && npm run build:main && npm run build:preload && npm run build:renderer",
    "build:main": "tsc -p tsconfig.electron.json",
    "build:preload": "vite build --config vite.config.preload.mts",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.preload.json && npm run typecheck:renderer",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json",
    "package": "npm run build && electron-builder --config electron-builder.foundation.json --win --dir",
    "pretest": "npm run build",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "build:spike": "tsc",
    "spike:node": "npm run build:spike && node dist/run-node.js",
    "spike:electron": "npm run build:spike && electron dist/electron-main.js",
    "spike:standalone": "npm run build:spike && node dist/standalone-client.js",
    "spike:delete-experiment": "npm run build:spike && node dist/delete-experiment.js",
    "package:win": "npm run build:spike && electron-builder --win --dir"
  },
  "main": "dist/electron-main.js",
  "dependencies": {
    "dotenv": "17.4.2",
    "prebuilt-tdlib": "0.1008067.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tdl": "8.1.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "concurrently": "10.0.5",
    "cross-env": "10.1.0",
    "electron": "44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "wait-on": "9.1.0"
  },
  "build": {
    "appId": "com.spike.telegram-desktop-client",
    "productName": "telegram-desktop-client-spike",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/tdl/prebuilds/**",
      "node_modules/@prebuilt-tdlib/**"
    ],
    "win": {
      "target": "dir"
    }
  }
}
